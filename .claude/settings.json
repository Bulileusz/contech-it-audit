{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Glob", "Grep",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(npm install:*)",
      "Bash(cargo add:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
